# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-solvebounty-mvp-secret-key-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Leave DATABASE_URL blank to automatically use local SQLite)
# DATABASE_URL=postgres://solvebounty:solvebountypass@localhost:5432/solvebounty
DATABASE_URL=

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=solvebounty-jwt-secret-key-change-in-prod
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=mock_paystack_webhook_secret

# AI Microservice
AI_SERVICE_URL=http://localhost:8001
AI_API_KEY=sb_ai_local_secret_key
LLM_PROVIDER=mock
LLM_API_KEY=

# Storage (S3 / Local fallback)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8001/ai/v1
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key
